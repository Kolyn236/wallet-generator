# Local Symfony CLI development defaults only.
# Copy to backend/.env for direct backend commands outside Docker.
# backend/.env is ignored by Git and must never contain production secrets.
APP_ENV=dev
APP_DEBUG=1
APP_SECRET=change-me-for-local-development
DEFAULT_URI=http://localhost:8080
DOGE_RECOMMENDED_FEE_RATE=0.01
BTC_RECOMMENDED_FEE_RATE=0.00010000
ETHEREUM_RPC_URL=
# Optional comma-separated exact reverse-proxy IPs/CIDRs. Empty means trust no proxy headers.
TRUSTED_PROXIES=
