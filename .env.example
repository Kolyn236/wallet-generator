# Non-secret Docker runtime defaults.
# Production APP_SECRET is intentionally absent and must come from an operator-controlled file/environment.
DOGE_RECOMMENDED_FEE_RATE=0.01
BTC_RECOMMENDED_FEE_RATE=0.00010000
# Required only when Ethereum endpoints are used. Do not commit provider credentials.
ETHEREUM_RPC_URL=
# Optional comma-separated exact reverse-proxy IPs/CIDRs. Leave empty by default.
# Never use 0.0.0.0/0 or an equivalent trust-everybody rule.
TRUSTED_PROXIES=
