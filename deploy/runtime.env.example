# Production-only runtime configuration.
# Copy this file outside the Git checkout, for example to:
# /etc/wallet-generator/runtime.env
# Keep the real file mode 0600 and never commit its values.

APP_SECRET=replace-with-a-long-random-production-secret
DEFAULT_URI=https://wallet.example.com

# Bind the application only to loopback by default. Put TLS/reverse proxy in front.
APP_BIND=127.0.0.1:8080

DOGE_RECOMMENDED_FEE_RATE=0.01
BTC_RECOMMENDED_FEE_RATE=0.00010000

# Required only when Ethereum endpoints are enabled.
ETHEREUM_RPC_URL=
