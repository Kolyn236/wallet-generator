# Docker Compose runtime overrides.
# Copy to .env and restart the PHP container after changing values.
DOGE_RECOMMENDED_FEE_RATE=0.01
BTC_RECOMMENDED_FEE_RATE=0.00010000
# Required only when Ethereum endpoints are used. Do not commit provider credentials.
ETHEREUM_RPC_URL=
# Public TRON reads/preparation/status only. Never expose credentials in the frontend.
TRON_RPC_URL=
